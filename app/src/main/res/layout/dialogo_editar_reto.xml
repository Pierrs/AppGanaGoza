<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/game_toolbar_background">

        <!-- Fondo con patrón de ondas -->
        <ImageView
            android:id="@+id/wave_pattern_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/wave_pattern"
            android:alpha="0.15" />

        <!-- Tarjeta central con esquinas redondeadas y fondo semitransparente -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            app:cardBackgroundColor="#80FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Encabezado con título y un ícono decorativo -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center">

                    <TextView
                        android:id="@+id/tvTitulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jersey"
                        android:padding="10dp"
                        android:rotation="-2"
                        android:shadowColor="#000000"
                        android:shadowDx="2"
                        android:shadowDy="2"
                        android:shadowRadius="3"
                        android:text="@string/editar_reto"
                        android:textAllCaps="true"
                        android:textColor="#FF5722"
                        android:textSize="28sp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_start"
                        app:tint="#FFEB3B"
                        app:layout_constraintTop_toTopOf="@+id/tvTitulo"
                        app:layout_constraintBottom_toBottomOf="@+id/tvTitulo"
                        app:layout_constraintStart_toEndOf="@+id/tvTitulo" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Texto descriptivo opcional -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:gravity="center"
                    android:text="Modifica tu reto y sorprende a todos"
                    android:textColor="#80000000"
                    android:textSize="14sp" />

                <!-- Campo de edición contenido dentro de una tarjeta para mejor estilo -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="3dp">

                    <EditText
                        android:id="@+id/idEditReto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:fontFamily="sans-serif"
                        android:hint="@string/reto_modificar"
                        android:minHeight="80dp"
                        android:padding="16dp"
                        android:gravity="top|start"
                        android:textColorHint="#80000000"
                        android:textSize="16sp" />
                </androidx.cardview.widget.CardView>

                <!-- Botones de acción con MaterialButton para un look moderno -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/idBtnCancelar"
                        android:layout_width="110dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="16dp"
                        android:backgroundTint="#FFFFFF"
                        android:text="@string/btn_cancelar"
                        android:textAllCaps="false"
                        android:textColor="#FF5722"
                        android:textSize="14sp"
                        app:cornerRadius="24dp"
                        app:strokeColor="#FF5722"
                        app:strokeWidth="1.5dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditar"
                        android:layout_width="110dp"
                        android:layout_height="48dp"
                        android:backgroundTint="#FF5722"
                        android:enabled="false"
                        android:text="@string/btn_guardar"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        app:cornerRadius="24dp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
