<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Contenedor principal con dimensiones exactas del original pero fondo mejorado -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_contendor"
            android:layout_width="302dp"
            android:layout_height="185dp"
            android:layout_gravity="center"
            android:layout_margin="@dimen/dimen_contenedor"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Fondo con gradiente (reemplaza bg_content_dialog_reto) -->

            <!-- Texto del reto con estilo mejorado pero dimensiones exactas originales -->

            <View
                android:layout_width="295dp"
                android:layout_height="208dp"
                android:background="@drawable/game_toolbar_background"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.0" />

            <TextView
                android:id="@+id/tv_reto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="70dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="60dp"
                android:fontFamily="@font/bangers"
                android:shadowColor="#80000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="1"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="reto que debes hacer"></TextView>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Círculo con ícono en dimensiones exactas originales pero con estilo mejorado -->
        <androidx.cardview.widget.CardView
            android:layout_width="90dp"
            android:layout_height="90dp"
            app:cardCornerRadius="45dp"
            app:cardElevation="6dp"
            app:layout_constraintBottom_toTopOf="@+id/cl_contendor"
            app:layout_constraintEnd_toEndOf="@+id/cl_contendor"
            app:layout_constraintStart_toStartOf="@+id/cl_contendor"
            app:layout_constraintTop_toTopOf="@+id/cl_contendor">

            <ImageView
                android:id="@+id/iv_retp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="20dp"
                android:src="@drawable/img_fondo" />
        </androidx.cardview.widget.CardView>

        <!-- Botón cerrar con dimensiones originales pero estilo mejorado -->
        <Button
            android:id="@+id/bt_cerrar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/color_general"
            android:text="@string/btn_CerrarDialogo"
            android:textColor="@color/white"
            android:textSize="25sp"
            android:fontFamily="@font/bangers"
            android:textAllCaps="false"
            app:cornerRadius="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/cl_contendor"
            app:layout_constraintEnd_toEndOf="@+id/cl_contendor"
            app:layout_constraintStart_toStartOf="@+id/cl_contendor"
            app:layout_constraintTop_toBottomOf="@+id/cl_contendor"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>