<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/vista_fondo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/game_toolbar_background" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/linea_guía_superior"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.15" />

    <ImageView
        android:id="@+id/logo_juego"
        android:layout_width="350dp"
        android:layout_height="350dp"
        android:elevation="12dp"
        android:contentDescription="@string/logo_del_juego"
        android:src="@drawable/pantalla_presentacion"
        app:layout_constraintTop_toBottomOf="@id/linea_guía_superior"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />

    <TextView
        android:id="@+id/tv_principal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:fontFamily="@font/bangers"
        android:text="@string/gana_goza"
        android:textAllCaps="true"
        android:textColor="#FFFFFF"
        android:textSize="64sp"
        android:textStyle="bold"
        android:shadowColor="#000000"
        android:shadowDx="3"
        android:shadowDy="3"
        android:shadowRadius="6"
        android:rotation="-3"
        android:elevation="14dp"
        app:layout_constraintTop_toBottomOf="@+id/logo_juego"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_slogan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/pierde_y_cumple_un_reto"
        android:textColor="#FFD700"
        android:textSize="24sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-condensed"
        android:shadowColor="#000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="2"
        android:elevation="10dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_principal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/contenedor_puntos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@+id/tv_slogan"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/punto1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/puntos_uno"
            android:textColor="#FF3B30"
            android:textSize="60sp"
            android:alpha="1.0" />

        <TextView
            android:id="@+id/punto2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/puntos_dos"
            android:textColor="#00CFFF"
            android:textSize="60sp"
            android:alpha="1.0" />

        <TextView
            android:id="@+id/punto3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/puntos_tres"
            android:textColor="#4CD964"
            android:textSize="60sp"
            android:alpha="1.0" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_cargando"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cargando"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="6dp"
        android:shadowColor="#000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="2"
        app:layout_constraintTop_toBottomOf="@+id/contenedor_puntos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:text="@string/version_del_juego"
        android:textColor="#E6FFFFFF"
        android:textSize="14sp"
        android:fontFamily="sans-serif-light"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
