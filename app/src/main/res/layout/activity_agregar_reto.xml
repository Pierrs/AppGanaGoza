<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/game_toolbar_background"
        tools:context=".view.AgregarReto">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:elevation="0dp">

            <include
                android:id="@+id/ic_contenedor_barra"
                layout="@layout/barra_principal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </com.google.android.material.appbar.AppBarLayout>

        <!-- Añadir patrón de ondas similar a la barra principal -->
        <ImageView
            android:id="@+id/wave_pattern_full"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/wave_pattern"
            android:alpha="0.15"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <!-- Título principal con formato similar a la barra -->
            <TextView
                android:id="@+id/tvTituloPantalla"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/bangers"
                android:text="¡MIS RETOS!"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:rotation="-2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Ícono decorativo como en la barra -->
            <ImageView
                android:id="@+id/decoration_title"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_start"
                app:tint="#FFEB3B"
                app:layout_constraintBottom_toBottomOf="@+id/tvTituloPantalla"
                app:layout_constraintStart_toEndOf="@+id/tvTituloPantalla"
                app:layout_constraintTop_toTopOf="@+id/tvTituloPantalla" />

            <!-- Subtítulo adaptado al estilo -->
            <TextView
                android:id="@+id/tvSubtituloPantalla"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="@font/bangers"
                android:text="Personaliza tus desafíos para el juego"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:shadowColor="#80000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvTituloPantalla" />

            <!-- Tarjeta principal con esquinas redondeadas como en la barra -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardViewContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#80FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvSubtituloPantalla">

                <!-- RecyclerView con padding adecuado -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycleView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="24dp"
                    tools:listitem="@layout/item_reto" />

                <!-- Estado vacío con estilo coherente - CORREGIDA LA PROPIEDAD lineSpacingExtra -->
                <TextView
                    android:id="@+id/emptyStateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:drawablePadding="20dp"
                    android:fontFamily="@font/bangers"
                    android:text="¡NO HAY RETOS TODAVÍA!\nPresiona + para crear uno nuevo"
                    android:textAlignment="center"
                    android:textColor="#FF5722"
                    android:textSize="20sp"
                    android:lineSpacingExtra="8dp"
                    android:rotation="-1"
                    android:visibility="gone"
                    app:drawableTopCompat="@android:drawable/ic_input_add" />

            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Botón flotante con estilo similar a la barra -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/float_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="24dp"
            android:contentDescription="@string/btn_flotante"
            app:backgroundTint="#FFFFFF"
            app:tint="#FF5722"
            app:srcCompat="@android:drawable/ic_input_add"
            app:fabSize="normal"
            app:elevation="8dp"
            app:pressedTranslationZ="16dp"
            app:borderWidth="0dp"
            app:maxImageSize="28dp" />

        <!-- Overlay de carga con estilo coherente -->
        <FrameLayout
            android:id="@+id/loadingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000"
            android:visibility="gone">

            <androidx.cardview.widget.CardView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_gravity="center"
                app:cardCornerRadius="35dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="4dp">

                <ProgressBar
                    android:id="@+id/progress"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="#FF5722" />
            </androidx.cardview.widget.CardView>

        </FrameLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>