<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/game_toolbar_background"
        tools:context=".view.ReglaJuego">

        <!-- Patrón de ondas como fondo -->
        <ImageView
            android:id="@+id/wave_pattern_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/wave_pattern"
            android:alpha="0.15" />

        <include
            android:id="@+id/ic_contenedor_barra"
            layout="@layout/barra_principal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Tarjeta principal con todo el contenido -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="20dp"
            app:cardBackgroundColor="#80FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:layout_constraintTop_toBottomOf="@+id/ic_contenedor_barra"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Contenedor de reglas -->
            <LinearLayout
                android:id="@+id/ll_contenedor"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Contenedor para título y estrella -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start">

                    <!-- Título con estilo lúdico -->
                    <TextView
                        android:id="@+id/tv_titulo_reglas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/bangers"
                        android:rotation="-2"
                        android:shadowColor="#000000"
                        android:shadowDx="2"
                        android:shadowDy="2"
                        android:shadowRadius="3"
                        android:text="@string/titulo_1"
                        android:textAllCaps="true"
                        android:textColor="#FF5722"
                        android:textSize="36sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Estrella decorativa -->
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="8dp"

                        app:layout_constraintBottom_toBottomOf="@+id/tv_titulo_reglas"
                        app:layout_constraintStart_toEndOf="@+id/tv_titulo_reglas"
                        app:layout_constraintTop_toTopOf="@+id/tv_titulo_reglas" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Descripción de las reglas con estilo mejorado -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="#20000000"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="16dp"
                        android:text="@string/descripcion_1"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif"
                        android:lineSpacingExtra="4dp" />

                </androidx.cardview.widget.CardView>

                <!-- Animación Lottie con decoración -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="16dp">

                    <com.airbnb.lottie.LottieAnimationView
                        android:layout_width="240dp"
                        android:layout_height="240dp"
                        android:layout_gravity="center"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="true"
                        app:lottie_rawRes="@raw/regla"/>

                    <!-- Decoraciones adicionales -->
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="30dp"
                        android:layout_marginBottom="30dp"
                        android:rotation="15"
                        android:src="@drawable/ic_start"
                        app:tint="#FFEB3B" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="40dp"
                        android:layout_marginBottom="60dp"
                        android:rotation="-10"
                        android:src="@drawable/ic_start"
                        app:tint="#FFEB3B" />
                </FrameLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>